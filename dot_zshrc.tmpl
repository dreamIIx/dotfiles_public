# export NNN_FIFO=/tmp/nnn.fifo
export NNN_PLUG='f:fzcd;d:diffs;D:disasm;z:ziparound;Z:tararound;h:-spawntermhere;p:-preview-tui;c:-.cbcp;g:-dragdrop;m:nmount;b:!cp -rv "$nnn" "$nnn".bak*;i:!convert "$nnn" png:- | xclip -sel clipboard -t image/png*;l:-!less -iR "$nnn"*;e:-!sudo -e "$nnn"*;r:rsynccp'
# export NB={{- .chezmoi.homeDir -}}/1/nnn_filepicker_buffer
export NB=${NNN_SEL:-${XDG_CONFIG_HOME:-$HOME/.config}/nnn/.selection}
export NNN_BMS="d:~/Downloads/;/:/;m:/mnt;D:~/Documents/;w:/run/media/dreamIIx/Windows/;s:/run/media/dreamIIx/dream11x/;S:/run/media/dreamIIx/Shared_drive/;b:/run/media/dreamIIx/dream11x/books;M:{{- .chezmoi.homeDir -}}/.config/nnn/mounts"

[ -n "$NNNLVL" ] && PS1="N$NNNLVL $PS1"

n ()
{
    # Block nesting of nnn in subshells
    [ "${NNNLVL:-0}" -eq 0 ] || {
        echo "nnn is already running"
        return
    }

    # The behaviour is set to cd on quit (nnn checks if NNN_TMPFILE is set)
    # If NNN_TMPFILE is set to a custom path, it must be exported for nnn to
    # see. To cd on quit only on ^G, remove the "export" and make sure not to
    # use a custom path, i.e. set NNN_TMPFILE *exactly* as follows:
    NNN_TMPFILE="${XDG_CONFIG_HOME:-$HOME/.config}/nnn/.lastd"
    # export NNN_TMPFILE="${XDG_CONFIG_HOME:-$HOME/.config}/nnn/.lastd"

    # Unmask ^Q (, ^V etc.) (if required, see `stty -a`) to Quit nnn
    # stty start undef
    # stty stop undef
    # stty lwrap undef
    # stty lnext undef

    # The command builtin allows one to alias nnn to n, if desired, without
    # making an infinitely recursive alias
    NB=${NNN_SEL:-${XDG_CONFIG_HOME:-$HOME/.config}/nnn/.selection}
    argss=$@
    VISUAL=nvim command nnn -P preview-tui -a -r -A -e -H -p $NB ${argss}

    [ ! -f "$NNN_TMPFILE" ] || {
        . "$NNN_TMPFILE"
        rm -f -- "$NNN_TMPFILE" > /dev/null
    }
}

