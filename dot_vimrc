set number relativenumber
syntax on
set cursorline
set showmode
set shiftwidth=4
set tabstop=4
set noexpandtab
set listchars=eol:$,tab:._,trail:~,extends:>,precedes:<
set showmatch
set hlsearch
set history=250
" set lazyredraw
set wrap

" use indentation of previous line
set autoindent
" use intelligent indentation for C
set smartindent

nmap cp :let @" = expand("%:p")<CR>

