# move a floating window
super + ctrl + shift + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}



# Misc

super + e
	thunar

super + v
	rofi -modi "clipboard:greenclip print" -show clipboard -run-command '{cmd}'

super + j
	rofi -modi emoji -show emoji -theme ~/.config/rofi/config.rasi

super + space
	setxkbmap us,ru

Print
	flameshot full --raw | xclip -selection clipboard -target image/png

super + Print
	mkdir -p ~/Documents/screenshots/ && flameshot full --path ~/Documents/screenshots/

ctrl + Print
	flameshot gui --raw | xclip -selection clipboard -target image/png

super + ctrl + Print
	mkdir -p ~/Documents/screenshots/ && flameshot gui --path ~/Documents/screenshots/

super + alt + l
	loginctl lock-session

ctrl + alt + m
	xclip -selection primary -o | xargs ~/2/mpv_dx/mpvdx
