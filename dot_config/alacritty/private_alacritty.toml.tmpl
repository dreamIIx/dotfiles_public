[env]
TERM = "alacritty"

[font]
size = 8.0

[font.bold]
family = "monospace"
style = "Bold"

[font.bold_italic]
family = "monospace"
style = "Bold Italic"

[font.italic]
family = "monospace"
style = "Italic"

# [font.line_indicator]
# background = "None"
# foreground = "None"

[font.normal]
family = "monospace"
style = "Regular"

[scrolling]
history = 30000
multiplier = 3

[window]
opacity = 0.83

[window.dimensions]
columns = 130
lines = 30

[general]
live_config_reload = true
import = ["{{- .chezmoi.homeDir -}}/.config/alacritty/themes/themes/horizon-dark.toml"]
# x = 6
# y = 6
