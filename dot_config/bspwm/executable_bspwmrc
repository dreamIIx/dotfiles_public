#!/bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &

bspc monitor eDP-1 -d \# \# \# \# \# \# \#
# bspc monitor HDMI-1 -d \# \# \# \# \# \# \#

bspc config border_width        2
bspc config window_gap          3
# bspc config top_padding			0

bspc config focus_follows_pointer false
bspc config pointer_modifier    super
# bspc config pointer_motion_interval 40

bspc config split_ratio          0.5

. "${HOME}/.cache/wal/colors.sh"

bspc config normal_border_color "$color1"
bspc config active_border_color "$color1"
bspc config focused_border_color "$color15"
bspc config presel_feedback_color "$color15"

bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config external_rules_command "$(./external_rules)"

bspc rule -a '*' state=floating

bspc rule -a kitty state=tiled follow=on
bspc rule -a Alacritty state=tiled follow=on
bspc rule -a Vivaldi-stable state=tiled follow=on
bspc rule -a *:*:"Save File" state=floating follow=on
bspc rule -a *:*:"View File" state=floating follow=on
bspc rule -a *:*:"Open File" state=floating follow=on
bspc rule -a gnuplot_qt state=tiled follow=on

$HOME/.config/polybar/launch.sh
pkill dunst
dunst -conf ~/.config/dunst/dunstrc --startup_notification &
wmname LG3D &
gnome-keyring-daemon -d &
dbus-update-activation-environment "$DISPAY" "$XAUTHORITY" "$WAYLAND_DISPLAY"
pgrep -x crow > /dev/null || crow &
